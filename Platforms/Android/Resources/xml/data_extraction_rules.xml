<?xml version="1.0" encoding="utf-8"?>
<!--
	Android 12+. Cloud backup and phone-to-phone transfer carry only the user's own networks
	(devices.json) and the app's settings; see backup_rules.xml.
-->
<data-extraction-rules>
	<cloud-backup>
		<include domain="file" path="devices.json" />
		<include domain="sharedpref" path="." />
	</cloud-backup>
	<device-transfer>
		<include domain="file" path="devices.json" />
		<include domain="sharedpref" path="." />
	</device-transfer>
</data-extraction-rules>
