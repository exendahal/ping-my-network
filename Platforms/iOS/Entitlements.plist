<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!--
            iCloud key-value storage: the backup of remembered networks and devices (DeviceStore).
            The App ID needs the iCloud capability with "Key-value storage" turned on.
        -->
        <key>com.apple.developer.ubiquity-kvstore-identifier</key>
        <string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>

        <!--
            Reading the Wi-Fi name (NEHotspotNetwork.FetchCurrent): without it the name is always
            empty. The App ID needs the "Access Wi-Fi Information" capability.
        -->
        <key>com.apple.developer.networking.wifi-info</key>
        <true/>
    </dict>
</plist>
