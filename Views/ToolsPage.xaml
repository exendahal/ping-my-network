<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PingMyNetwork.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    xmlns:util="clr-namespace:PingMyNetwork.Helper.Utilities"
    ClassId="{x:Static util:Routes.TOOLS}">

    <ScrollView>
        <!--
            Two grouped lists, so the choice reads as "find a problem" or "do a job" rather than
            seven equal cards. Stacked on narrow windows; side by side on wide ones (code-behind).
        -->
        <Grid
            x:Name="PageGrid"
            Padding="{StaticResource PagePaddingCompact}"
            ColumnSpacing="{StaticResource SpaceXl}"
            HorizontalOptions="Center"
            MaximumWidthRequest="{StaticResource ContentMaxWidth}"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="{StaticResource SpaceL}">

            <VerticalStackLayout x:Name="Header">
                <Label
                    SemanticProperties.HeadingLevel="Level1"
                    Style="{StaticResource ScreenTitle}"
                    Text="{x:Static res:AppResources.ToolsTitle}" />
                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolsSubtitle}" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="DiagnoseGroup" Spacing="{StaticResource SpaceS}">
                <Label
                    Margin="4,0"
                    SemanticProperties.HeadingLevel="Level2"
                    Style="{StaticResource TextHeadline}"
                    Text="{x:Static res:AppResources.ToolsDiagnose}" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout
                        BackgroundColor="{AppThemeBinding Light={StaticResource OutlineLight},
                                                          Dark={StaticResource OutlineDark}}"
                        Spacing="1">
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_PING}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolPingTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolPingBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.NETWORK_PING}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolPingTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolPingBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_TRACEROUTE}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolTracerouteTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolTracerouteBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.ROUTE}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolTracerouteTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolTracerouteBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_DNS}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolDnsTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolDnsBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.DNS}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolDnsTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolDnsBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_PORTS}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolPortsTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolPortsBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.RADAR}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolPortsTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolPortsBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="UtilityGroup" Spacing="{StaticResource SpaceS}">
                <Label
                    Margin="4,0"
                    SemanticProperties.HeadingLevel="Level2"
                    Style="{StaticResource TextHeadline}"
                    Text="{x:Static res:AppResources.ToolsUtilities}" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout
                        BackgroundColor="{AppThemeBinding Light={StaticResource OutlineLight},
                                                          Dark={StaticResource OutlineDark}}"
                        Spacing="1">
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_SPEED}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolSpeedTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolSpeedBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.SPEED}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolSpeedTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolSpeedBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_WAKE}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolWakeTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolWakeBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.POWER}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolWakeTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolWakeBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                        <Grid
                            Padding="16,12"
                            ClassId="{x:Static util:Routes.TOOL_SUBNET}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource SpaceM}"
                            SemanticProperties.Description="{x:Static res:AppResources.ToolSubnetTitle}"
                            SemanticProperties.Hint="{x:Static res:AppResources.ToolSubnetBody}"
                            Style="{StaticResource ListRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight},
                                                                  Dark={StaticResource AccentTintDark}}"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.CALCULATE}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="{StaticResource FontBody}"
                                    Text="{x:Static res:AppResources.ToolSubnetTitle}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ToolSubnetBody}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="18"
                                Style="{StaticResource Icon}"
                                Text="{x:Static util:MaterialIcon.CHEVRON_RIGHT}"
                                TextColor="{AppThemeBinding Light={StaticResource CaptionLight},
                                                            Dark={StaticResource CaptionDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
