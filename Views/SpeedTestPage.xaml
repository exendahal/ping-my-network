<?xml version="1.0" encoding="utf-8" ?>
<views:ToolPage
    x:Class="PingMyNetwork.Views.SpeedTestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PingMyNetwork.Controls"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    xmlns:util="clr-namespace:PingMyNetwork.Helper.Utilities"
    xmlns:views="clr-namespace:PingMyNetwork.Views"
    xmlns:vm="clr-namespace:PingMyNetwork.ViewModels"
    x:DataType="vm:SpeedTestViewModel">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.ToolSpeedTitle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,8,16,32"
                MaximumWidthRequest="{StaticResource ReadableMaxWidth}"
                Spacing="{StaticResource SpaceL}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <!--
                            A meter rather than a bare ring: the scale says what the number means (fine, but far from
                            gigabit), and the needle and number move live while the test runs.
                        -->
                        <Grid
                            HeightRequest="260"
                            HorizontalOptions="Center"
                            WidthRequest="260">
                            <controls:RingGaugeView
                                Fraction="{Binding Fraction}"
                                Level="{Binding Level}"
                                StrokeWidth="14"
                                Ticks="{Binding Ticks}" />
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                InputTransparent="True"
                                VerticalOptions="Center">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    IsVisible="{Binding HasPhase}"
                                    Style="{StaticResource TextLabel}"
                                    Text="{Binding PhaseText}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontHero}"
                                    HorizontalTextAlignment="Center"
                                    SemanticProperties.Description="{Binding Verdict}"
                                    Text="{Binding LiveValue}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource TextLabel}"
                                    Text="{x:Static res:AppResources.SpeedUnit}" />
                            </VerticalStackLayout>
                        </Grid>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="{StaticResource SpaceS}">
                            <ActivityIndicator
                                HeightRequest="18"
                                IsRunning="{Binding IsRunning}"
                                IsVisible="{Binding IsRunning}"
                                WidthRequest="18"
                                Color="{AppThemeBinding Light={StaticResource AccentLight},
                                                        Dark={StaticResource AccentDark}}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource TextBody}"
                                Text="{Binding Verdict}" />
                        </HorizontalStackLayout>
                        <!--
                            One strip of three centred results rather than three cards: a card's padding and icon left
                            too little room for "Download" on a phone.
                        -->
                        <Border Padding="0,12" Style="{StaticResource GroupCard}">
                            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2"
                                HorizontalOptions="Center">
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.DOWNLOAD}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource TextLabel}"
                                    Text="{x:Static res:AppResources.SpeedDownload}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontTileValue}"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding DownloadText}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                            </VerticalStackLayout>
                            <BoxView
                                Grid.Column="1"
                                Color="{AppThemeBinding Light={StaticResource OutlineLight},
                                                        Dark={StaticResource OutlineDark}}"
                                WidthRequest="1" />
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="2"
                                HorizontalOptions="Center">
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.UPLOAD}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource TextLabel}"
                                    Text="{x:Static res:AppResources.SpeedUpload}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontTileValue}"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding UploadText}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                            </VerticalStackLayout>
                            <BoxView
                                Grid.Column="3"
                                Color="{AppThemeBinding Light={StaticResource OutlineLight},
                                                        Dark={StaticResource OutlineDark}}"
                                WidthRequest="1" />
                            <VerticalStackLayout
                                Grid.Column="4"
                                Spacing="2"
                                HorizontalOptions="Center">
                                <Label
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource Icon}"
                                    Text="{x:Static util:MaterialIcon.TIMER}"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                                Dark={StaticResource AccentDark}}" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource TextLabel}"
                                    Text="{x:Static res:AppResources.SpeedLatency}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontTileValue}"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding LatencyText}"
                                    TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                Dark={StaticResource OnSurfaceDark}}" />
                            </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Button
                            Command="{Binding RunCommand}"
                            HorizontalOptions="Center"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding RunButtonText}" />
                    </VerticalStackLayout>
                </Border>
                <!--  Why the last run failed.  -->
                <Border
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource NoticeBanner}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceM}">
                        <Label
                            FontSize="20"
                            Style="{StaticResource Icon}"
                            Text="{x:Static util:MaterialIcon.ERROR}"
                            TextColor="{AppThemeBinding Light={StaticResource StatusBadLight},
                                                        Dark={StaticResource StatusBadDark}}" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource TextBody}"
                            Text="{Binding ErrorText}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <Label
                    Margin="4,0"
                    Style="{StaticResource TextLabel}"
                    Text="{x:Static res:AppResources.SpeedFooter}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsMetered}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StatusFairLight}, Dark={StaticResource StatusFairDark}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ToolPage>
