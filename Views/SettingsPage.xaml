<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PingMyNetwork.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PingMyNetwork.Controls"
    xmlns:models="clr-namespace:PingMyNetwork.Models"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    xmlns:util="clr-namespace:PingMyNetwork.Helper.Utilities"
    xmlns:vm="clr-namespace:PingMyNetwork.ViewModels"
    x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.SettingsTitle}" />

        <ScrollView Grid.Row="1">
            <!--  Inset grouped lists, as on the platforms' own settings screens.  -->
            <VerticalStackLayout Padding="16,0,16,32" MaximumWidthRequest="{StaticResource ReadableMaxWidth}">

                <Label Style="{StaticResource SectionHeader}" Text="{x:Static res:AppResources.SettingsAppearance}" />
                <Border Padding="16,12,8,4" Style="{StaticResource GroupCard}">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ThemeOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ChoiceOption">
                                <!--  Both styles come from triggers: a local Style would outrank them.  -->
                                <Button
                                    Margin="0,0,8,8"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SelectThemeCommand, x:DataType=vm:SettingsViewModel}"
                                    CommandParameter="{Binding Key}"
                                    Text="{Binding Name}">
                                    <Button.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsSelected}"
                                            TargetType="Button"
                                            Value="True">
                                            <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsSelected}"
                                            TargetType="Button"
                                            Value="False">
                                            <Setter Property="Style" Value="{StaticResource Chip}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="{x:Static res:AppResources.SettingsAbout}" />
                <Border Style="{StaticResource GroupCard}">
                    <controls:SettingsRow
                        Title="{x:Static res:AppResources.SettingsVersion}"
                        Icon="{x:Static util:MaterialIcon.INFO}"
                        Value="{Binding VersionText}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
