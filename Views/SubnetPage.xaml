<?xml version="1.0" encoding="utf-8" ?>
<views:ToolPage
    x:Class="PingMyNetwork.Views.SubnetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PingMyNetwork.Controls"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    xmlns:util="clr-namespace:PingMyNetwork.Helper.Utilities"
    xmlns:views="clr-namespace:PingMyNetwork.Views"
    xmlns:vm="clr-namespace:PingMyNetwork.ViewModels"
    x:DataType="vm:SubnetViewModel">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.ToolSubnetTitle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,8,16,32"
                MaximumWidthRequest="{StaticResource ReadableMaxWidth}"
                Spacing="{StaticResource SpaceL}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Margin="4,0"
                                Style="{StaticResource TextLabel}"
                                Text="{x:Static res:AppResources.FieldSubnet}" />
                            <Border Padding="12,0,4,0" Style="{StaticResource GroupCard}">
                                <Entry
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    Keyboard="Url"
                                    Placeholder="{x:Static res:AppResources.SubnetPlaceholder}"
                                    ReturnType="Done"
                                    SemanticProperties.Description="{x:Static res:AppResources.FieldSubnet}"
                                    Text="{Binding Input}" />
                            </Border>
                        </VerticalStackLayout>
                        <Label
                            IsVisible="{Binding IsInvalid}"
                            Style="{StaticResource TextLabel}"
                            Text="{x:Static res:AppResources.SubnetInvalid}" />
                    </VerticalStackLayout>
                </Border>
                <controls:DetailSectionsView CopyCommand="{Binding CopyCommand}" Sections="{Binding Sections}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ToolPage>
