<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PingMyNetwork.Views.PlannedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings">

    <!--  A destination still being built: says what it will do, instead of an empty screen.  -->
    <Grid x:Name="PageGrid" Padding="{StaticResource PagePaddingCompact}">
        <VerticalStackLayout
            MaximumWidthRequest="420"
            Spacing="{StaticResource SpaceM}"
            VerticalOptions="Center">

            <Border
                HeightRequest="72"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 36"
                StrokeThickness="0"
                WidthRequest="72"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                  Dark={StaticResource SurfaceDark}}">
                <Label
                    x:Name="IconLabel"
                    FontSize="34"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Icon}"
                    TextColor="{AppThemeBinding Light={StaticResource AccentLight},
                                                Dark={StaticResource AccentDark}}" />
            </Border>

            <Label
                x:Name="HeadingLabel"
                HorizontalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource TextTitle}" />

            <Label
                x:Name="BodyLabel"
                HorizontalTextAlignment="Center"
                Style="{StaticResource TextBody}" />

            <Border
                Padding="12,4"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource OutlineLight},
                                         Dark={StaticResource OutlineDark}}">
                <Label Style="{StaticResource TextLabel}" Text="{x:Static res:AppResources.ComingBadge}" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
