<?xml version="1.0" encoding="utf-8" ?>
<views:ToolPage
    x:Class="PingMyNetwork.Views.DnsLookupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PingMyNetwork.Controls"
    xmlns:models="clr-namespace:PingMyNetwork.Models"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    xmlns:util="clr-namespace:PingMyNetwork.Helper.Utilities"
    xmlns:views="clr-namespace:PingMyNetwork.Views"
    xmlns:vm="clr-namespace:PingMyNetwork.ViewModels"
    x:DataType="vm:DnsLookupViewModel">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.ToolDnsTitle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,8,16,32"
                MaximumWidthRequest="{StaticResource ReadableMaxWidth}"
                Spacing="{StaticResource SpaceL}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Margin="4,0"
                                Style="{StaticResource TextLabel}"
                                Text="{x:Static res:AppResources.FieldDomain}" />
                            <Border Padding="12,0,4,0" Style="{StaticResource GroupCard}">
                                <Entry
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    Keyboard="Url"
                                    Placeholder="{x:Static res:AppResources.DnsNamePlaceholder}"
                                    ReturnCommand="{Binding RunCommand}"
                                    ReturnType="Go"
                                    SemanticProperties.Description="{x:Static res:AppResources.FieldDomain}"
                                    Text="{Binding Name}" />
                            </Border>
                        </VerticalStackLayout>
                        <Label
                            Margin="4,0,4,-6"
                            Style="{StaticResource TextLabel}"
                            Text="{x:Static res:AppResources.FieldRecordType}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Types}" Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ChoiceOption">
                                    <!--  Both styles come from triggers: a local Style would outrank them.  -->
                                    <Button
                                        Margin="0,0,8,8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DnsLookupViewModel}}, Path=SelectTypeCommand, x:DataType=vm:DnsLookupViewModel}"
                                        CommandParameter="{Binding Key}"
                                        Text="{Binding Name}">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Button"
                                                Value="True">
                                                <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Button"
                                                Value="False">
                                                <Setter Property="Style" Value="{StaticResource Chip}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Margin="4,0"
                                Style="{StaticResource TextLabel}"
                                Text="{x:Static res:AppResources.FieldDnsServer}" />
                            <Border Padding="12,0,4,0" Style="{StaticResource GroupCard}">
                                <Entry
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    Keyboard="Url"
                                    Placeholder="{Binding ServerPlaceholder}"
                                    ReturnCommand="{Binding RunCommand}"
                                    ReturnType="Go"
                                    SemanticProperties.Description="{x:Static res:AppResources.FieldDnsServer}"
                                    Text="{Binding Server}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button
                            Command="{Binding RunCommand}"
                            HorizontalOptions="Start"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding RunButtonText}" />
                    </VerticalStackLayout>
                </Border>
                <!--  Why the last run failed.  -->
                <Border
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource NoticeBanner}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceM}">
                        <Label
                            FontSize="20"
                            Style="{StaticResource Icon}"
                            Text="{x:Static util:MaterialIcon.ERROR}"
                            TextColor="{AppThemeBinding Light={StaticResource StatusBadLight},
                                                        Dark={StaticResource StatusBadDark}}" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource TextBody}"
                            Text="{Binding ErrorText}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <VerticalStackLayout IsVisible="{Binding HasResults}" Spacing="{StaticResource SpaceM}">
                    <Label
                        Margin="4,0"
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource TextHeadline}"
                        Text="{Binding Summary}" />
                    <Border Style="{StaticResource GroupCard}">
                        <VerticalStackLayout Padding="0,4" BindableLayout.ItemsSource="{Binding Records}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ResultRow">
                                    <controls:ResultRowView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ToolPage>
