<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PingMyNetwork.Views.DeviceDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PingMyNetwork.Controls"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    xmlns:util="clr-namespace:PingMyNetwork.Helper.Utilities"
    xmlns:vm="clr-namespace:PingMyNetwork.ViewModels"
    x:DataType="vm:DeviceDetailsViewModel">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            MaximumWidthRequest="{StaticResource ReadableMaxWidth}"
            Padding="8,8,8,0"
            ColumnDefinitions="Auto,*">
            <Button
                Command="{Binding BackCommand}"
                SemanticProperties.Description="{x:Static res:AppResources.ActionBack}"
                Style="{StaticResource IconButton}"
                Text="{x:Static util:MaterialIcon.ARROW_BACK}"
                ToolTipProperties.Text="{x:Static res:AppResources.ActionBack}" />
            <Label
                Grid.Column="1"
                Margin="4,0"
                Style="{StaticResource TextTitle}"
                Text="{x:Static res:AppResources.DeviceDetailsTitle}"
                VerticalOptions="Center" />
        </Grid>

        <controls:DeviceDetailsView Grid.Row="1" />
    </Grid>
</ContentPage>
