<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PingMyNetwork.Controls.DetailSectionsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PingMyNetwork.Controls"
    xmlns:models="clr-namespace:PingMyNetwork.Models"
    xmlns:res="clr-namespace:PingMyNetwork.Resources.Strings"
    x:Name="Root">

    <!--
        Titled cards of label and value rows, tap a row to copy its value. A handful of short,
        bounded sections, so a bindable layout rather than a virtualised list.
    -->
    <VerticalStackLayout x:Name="SectionList">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:DetailSection">
                <VerticalStackLayout>
                    <Label Style="{StaticResource SectionHeader}" Text="{Binding Title}" />

                    <!--
                        Rows sit on the outline colour with 1 unit between them, so the hairlines
                        appear only between rows, never doubled at the edges.
                    -->
                    <Border Style="{StaticResource GroupCard}">
                        <VerticalStackLayout
                            BackgroundColor="{AppThemeBinding Light={StaticResource OutlineLight},
                                                              Dark={StaticResource OutlineDark}}"
                            BindableLayout.ItemsSource="{Binding Rows}"
                            Spacing="1">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DetailRow">
                                    <!--
                                        Title above value: long values (IPv6, MAC, dates) then never
                                        squeeze the title onto two lines on a phone.
                                    -->
                                    <Grid
                                        Padding="16,10"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="{StaticResource SpaceM}"
                                        Style="{StaticResource ListRow}"
                                        MinimumHeightRequest="{StaticResource TouchTarget}"
                                        RowDefinitions="Auto,Auto"
                                        SemanticProperties.Description="{Binding Value}"
                                        SemanticProperties.Hint="{x:Static res:AppResources.DetailsCopyHint}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=CopyCommand, x:DataType=controls:DetailSectionsView}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label
                                            Style="{StaticResource TextLabel}"
                                            Text="{Binding Title}" />
                                        <Label
                                            Grid.Row="1"
                                            FontSize="{StaticResource FontBody}"
                                            IsVisible="{Binding IsCopyable}"
                                            LineBreakMode="CharacterWrap"
                                            Text="{Binding Value}"
                                            TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight},
                                                                        Dark={StaticResource OnSurfaceDark}}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
